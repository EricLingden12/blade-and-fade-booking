# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / publishable key. Safe to expose: Row Level Security gates it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" / secret key. Bypasses RLS — server-side only.
# Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# Absolute origin, used for links in confirmation screens.
# Leave unset on Vercel — it is derived from VERCEL_URL automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Seed script only (npm run seed) — not needed at runtime
# ---------------------------------------------------------------------------

# Email/password for the admin user the seed script creates.
SEED_ADMIN_EMAIL=owner@bladeandfade.ae
SEED_ADMIN_PASSWORD=

# --- Payments (optional) ---------------------------------------------------
# Leave both blank and the site takes bookings with no payment step at all,
# exactly as it did before deposits existed. Deposits only happen when these
# are set AND the shop has switched them on in /admin/settings.
#
# Use test keys (sk_test_…) unless you genuinely intend to charge real cards.
# Get them at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`, or from
# the webhook endpoint you create in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=
